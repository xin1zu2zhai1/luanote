% 箱の太さの変更
\makeatletter
% 太さの関数
\newcommand{\box@thickness}[1]{%
\@cotA=0
\@cotB=0
%
  \@futosa=\@FUTOSA{#1}
%
  \@cotA=#1
  \advance\@cotA by 1
  \ifnum\@cotA>10
    \@Dfutosa=\@FUTOSA{10}
  \else
    \@Dfutosa=\@FUTOSA{\@cotA}% 大問の太さ
  \fi
%
  \@cotB=#1
  \advance\@cotB by -1
  \ifnum\@cotB<1
    \@Hfutosa=\@FUTOSA{1}
  \else
    \@Hfutosa=\@FUTOSA{\@cotB}% 破線の太さ
  \fi
}%
\makeatother


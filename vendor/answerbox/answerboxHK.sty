\makeatletter
\newcommand{\@PUTBOX}[2][%
    scale=1.0
]{%
\@cotX=0
\@cotY=0
\@dimA=0\p@
\@dimB=0\p@
\haba@shoumon=0\p@
% 値の引き継ぎ
\ifnum\@BUNKI=0;
  \tempY@takasa=\@takasa
  \tempY@Swidth=\@Swidth
  \tempY@box@thickness@value=\box@thickness@value
  \box@thickness{\tempY@box@thickness@value}
\fi;
\tempY@box@scale=\box@scale%

\setkeys{putbox}{#1}
  \bangouA=#2;
  \advance\@bangouB by \bangouA;
  \@cotX=\bangouA;
  \advance\@cotX by -1;
% 箱の右下の高さ
  \advance\@choutenB by \@takasa;
% 箱の幅
  \@haba=\strippt\tempY@box@scale\@habaA;
% 全体の箱
  \draw[line width=\@futosa] (0,-\@choutenA) rectangle (\@haba,-\@choutenB);

\@dimB=\@Swidth;
\@dimA=\@haba;%

\ifnum\@cotX=0;
  \advance \@dimA by -\@dimB;% 小問番号の幅だけ引く
\else
  \multiply \@dimB by \bangouA;% 小問番号の幅の和
  \advance \@dimA by -\@dimB;% 小問番号の幅だけ引く
  \divide \@dimA by \bangouA;% 小問の数だけ割る
\fi
\haba@shoumon=0.98\@dimA% ちょっと狭める

\ifnum\@cotX=0;
  \draw[line width=\@Hfutosa,densely dotted] (\@Swidth,-\@choutenA)--(\@Swidth,-\@choutenB);% 右側
\else
\foreach ~ in{1,...,\@cotX}{%
  \draw[line width=\@futosa] (\@haba/\bangouA*~,-\@choutenA)--(\@haba/\bangouA*~,-\@choutenB);% 左側
}
\foreach ~ in{0,1,...,\@cotX}{%
  \draw[line width=\@Hfutosa,densely dotted] (\@haba/\bangouA*~+\@Swidth,-\@choutenA)--(\@haba/\bangouA*~+\@Swidth,-\@choutenB);% 右側
}
\fi

\foreach ~ in{1,...,\bangouA}{%
  \@cotY=\shoumon@bangou;%
  \advance\@cotY by ~;% 小問番号の引継
  \coordinate (NO\the\@cotY) at ({\@haba/\bangouA*(~ - 1) +\@Swidth/2},-0.5*\@choutenA-0.5*\@choutenB);
% 解答欄の真ん中の場所
  \coordinate (P\the\@cotY) at ({\@haba/\bangouA*(~ - 1) +\@Swidth +0.5*(\@haba/\bangouA-\@Swidth)},-0.5*\@choutenA-0.5*\@choutenB);
}
% 小問番号の記述
\foreach ~ in{1,...,\bangouA}{%
  \@cotY=\shoumon@bangou;%
  \advance\@cotY by ~;
  \draw (NO\the\@cotY) node[] {\@shoumon@kigou{\@cotY}};
}
% 次の箱の左上の高さ
\advance\@choutenA by \@takasa;
% 次の行へ番号の引き継ぎ
\advance\shoumon@bangou by \bangouA;
\advance\@bangouB by \bangouA;

% 値の引き継ぎ
\ifnum\@BUNKI=0;
  \@takasa=\tempY@takasa
  \@Swidth=\tempY@Swidth
  \box@thickness@value=\tempY@box@thickness@value
  \box@thickness{\box@thickness@value}
\fi
}
\makeatother

